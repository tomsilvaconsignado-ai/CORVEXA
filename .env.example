# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Na Vercel, cadastre as mesmas variáveis
# em Project Settings > Environment Variables.

# URL do projeto
VITE_SUPABASE_URL="https://seu-projeto.supabase.co"

# Chave pública "anon" (pode ir para o navegador; a segurança vem do RLS)
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica"

# NUNCA coloque a service_role key em variáveis VITE_*: tudo que começa com
# VITE_ é embutido no JavaScript público do site.
