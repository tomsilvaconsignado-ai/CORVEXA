# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERVER CONFIGURATION
PORT="3000"
NODE_ENV="development"

# SUPABASE / POSTGRESQL (OPCIONAL PARA PERSISTÊNCIA EM NUVEM)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# BANRISUL BPI & PARCEIROS BANCÁRIOS (HOMOLOGAÇÃO / PRODUÇÃO)
BANRISUL_CLIENT_ID="your-banrisul-client-id"
BANRISUL_CLIENT_SECRET="your-banrisul-client-secret"
BANRISUL_CERT_PATH="/certs/banrisul_mtls.pem"
DATAPREV_CERT_PATH="/certs/dataprev_ecnpj.pfx"
